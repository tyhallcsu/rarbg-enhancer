{
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "printWidth": 120,
    "endOfLine": "lf",
    "arrowParens": "always",
    "overrides": [
        {
            "files": ["*.yml", "*.yaml", "*.json", "*.md"],
            "options": { "tabWidth": 2 }
        }
    ]
}
